{
  "name": "sankyu",
  "productName": "三球",
  "version": "0.1.0",
  "description": "ジャグリングを題材にした短編インクリメンタルゲーム",
  "private": true,
  "main": "./out/main/main.js",
  "author": "yuksew",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "compile": "electron-vite build",
    "build": "pnpm compile && electron-builder --win --mac --linux",
    "build:win": "pnpm compile && electron-builder --win",
    "build:mac": "pnpm compile && electron-builder --mac",
    "build:linux": "pnpm compile && electron-builder --linux",
    "steam:upload": "node scripts/steam/upload.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@swc/core"
    ]
  }
}
